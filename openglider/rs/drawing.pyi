from .vector import PolyLine2D, Vector2D
from collections.abc import Sequence
from typing import Any, final

@final
class Layer:
    def __copy__(self, /) -> Layer: ...
    def __deepcopy__(self, /, _memo: Any) -> Layer: ...
    def __new__(cls, /, lines: Sequence[PolyLine2D] |None = None, texts: Sequence[Text] |None = None, style: LayerStyle |None = None) -> Layer: ...
    def __repr_svg_(self, /) -> str: ...
    def add_entity(self, /, entity: Any) -> None: ...
    def add_line(self, /, line: PolyLine2D) -> None: ...
    def add_text(self, /, text: Text) -> None: ...
    def bbox(self, /) -> tuple[float, float, float, float] |None: ...
    def copy(self, /) -> Layer: ...
    @property
    def lines(self, /) -> list[PolyLine2D]: ...
    @lines.setter
    def lines(self, /, value: Sequence[PolyLine2D]) -> None: ...
    def move(self, /, offset: Vector2D |Sequence[float]) -> Layer: ...
    def rotate(self, /, angle: float, radians: bool, center: Vector2D |Sequence[float] |None) -> Layer: ...
    def scale(self, /, factor: float) -> Layer: ...
    @property
    def style(self, /) -> LayerStyle: ...
    @style.setter
    def style(self, /, value: LayerStyle) -> None: ...
    @property
    def texts(self, /) -> list[Text]: ...
    @texts.setter
    def texts(self, /, value: Sequence[Text]) -> None: ...

@final
class LayerEditor:
    def __enter__(self, /) -> LayerEditor: ...
    def __exit__(self, /, _exc_type: Any |None, _exc: Any |None, _tb: Any |None) -> bool: ...
