    def add_part(self, /, part: Part) -> None: ...
    def append_left(self, /, other: Layout, distance: float = 0.0) -> Layout: ...
    def append_top(self, /, other: Layout, distance: float = 0.0) -> Layout: ...
    def bbox(self, /) -> tuple[float, float, float, float] |None: ...
    def copy(self, /) -> Layout: ...
    def export_dxf(self, /, path: str) -> None: ...
    def export_svg(self, /, path: str, border: float = 0.0) -> None: ...
    @property
    def height(self, /) -> float: ...
    def join(self, /, other: Layout) -> Layout: ...
    @property
    def max_x(self, /) -> float: ...
    @property
    def max_y(self, /) -> float: ...
    @property
    def min_x(self, /) -> float: ...
    @property
    def min_y(self, /) -> float: ...
    def move(self, /, offset: Vector2D |Sequence[float]) -> Layout: ...
    def move_to(self, /, target: Vector2D |Sequence[float]) -> None: ...
    @property
    def parts(self, /) -> list[Part]: ...
    @parts.setter
    def parts(self, /, value: Sequence[Part]) -> None: ...
    def rotate(self, /, angle: float, radians: bool, center: Vector2D |Sequence[float] |None) -> Layout: ...
    def scale(self, /, factor: float) -> Layout: ...
    @staticmethod
    def stack_column(parts: Sequence[Any], distance: float, center_x: bool = True) -> Layout: ...
    @staticmethod
    def stack_row(parts: Sequence[Any], distance: float, center_y: bool = True) -> Layout: ...
