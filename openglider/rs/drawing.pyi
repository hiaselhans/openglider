    def add_line(self, /, layer_name: str, line: PolyLine2D) -> None: ...
    def add_text(self, /, layer_name: str, text: Text) -> None: ...
    def bbox(self, /) -> tuple[float, float, float, float] |None: ...
    def copy(self, /) -> Part: ...
