    def b(self, /, value: int) -> None: ...
    @property
    def c(self, /) -> int: ...
    @c.setter
    def c(self, /, value: int) -> None: ...
    @property
    def d(self, /) -> int: ...
    @d.setter
    def d(self, /, value: int) -> None: ...

@final
class Triangle:
